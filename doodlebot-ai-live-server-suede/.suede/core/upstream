#!/usr/bin/env bash
# .suede/core/upstream — ships INSIDE a suede dependency:
#     <repo>/<dependency>/.suede/core/upstream
#
# Running it proposes THIS dependency's local changes to the library upstream,
# as a reviewable PR against the library's `main`, then waits for that PR and
# prints its link (pass --no-wait to skip waiting):
#     ./<dependency>/.suede/core/upstream       (if executable)
#     bash <dependency>/.suede/core/upstream
#
# Pushing needs the SSH key behind the recorded remote: unlike diff, deps.sh
# and sync there is no --https, and pushing with a token is not supported yet
# (see the note in the hosted script before its push).
#
# Thin bootstrapper: the real logic is hosted so it can evolve without
# re-shipping dependencies. It locates the dependency root two levels up (see
# below) and hands it to the hosted script. Override the host for forks and
# testing with SUEDE_UPSTREAM_URL.

set -euo pipefail

err() { echo "error: $*" >&2; exit 1; }

# Physical paths, like `sync` and `diff`: reached through a symlink (the
# declaration or an edge), the real folder is the subrepo, and `git subrepo
# push` on the symlink path fails.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" >/dev/null 2>&1 && pwd -P)" \
  || err "cannot resolve script location"

# The dependency root is exactly two levels up from this script
# (<dep>/.gitrepo, with this script at <dep>/.suede/core/upstream).
DEP_DIR="$(cd "$SELF_DIR/../.." >/dev/null 2>&1 && pwd -P)" \
  || err "cannot resolve dependency root above $SELF_DIR"
[ -f "$DEP_DIR/.gitrepo" ] \
  || err "no .gitrepo found at $DEP_DIR/.gitrepo — is this inside a vendored suede dependency?"

command -v curl >/dev/null || err "curl not found"

# git-subrepo is a git subcommand found on PATH, but an environment can have it
# installed without it being reachable - a devcontainer feature or a login
# shell profile that a non-interactive script never sourced. GIT_SUBREPO_ROOT
# is the marker those installs leave behind, and its `.rc` exports a PATH the
# hosted script below inherits, so this is done here rather than there.
ensure_git_subrepo() {
  git subrepo --version >/dev/null 2>&1 && return 0
  [[ -n "${GIT_SUBREPO_ROOT-}" && -f "${GIT_SUBREPO_ROOT-}/.rc" ]] || return 1
  # `.rc` ends by sourcing a completion script written for an interactive
  # shell, so strictness comes off for the duration and the outcome is checked
  # rather than trusted.
  set +eu
  # shellcheck disable=SC1091
  source "$GIT_SUBREPO_ROOT/.rc"
  set -eu
  git subrepo --version >/dev/null 2>&1
}

ensure_git_subrepo \
  || err "git-subrepo is not installed (https://github.com/ingydotnet/git-subrepo)"

HOST="${SUEDE_UPSTREAM_URL:-https://suede.sh/upstream}"

exec bash <(curl -fsSL "$HOST") "$DEP_DIR" "$@"
